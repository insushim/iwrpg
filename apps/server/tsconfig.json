{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "types": ["node"],
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "../client/src/data/**/*"
  ]
}
