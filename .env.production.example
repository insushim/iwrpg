# ┌──────────────────────────────────────────────────┐
# │ Vercel — Project → Settings → Environment Variables │
# └──────────────────────────────────────────────────┘
# Replace with your actual Fly app domain after fly deploy.
VITE_SERVER_WS=wss://runeword-chronicle-server.fly.dev

# ┌──────────────────────────────────────────────────┐
# │ Fly.io — fly secrets set KEY=VALUE …                │
# └──────────────────────────────────────────────────┘
# Restrict CORS to your Vercel domain (comma-separated). Use * for open access.
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Colyseus monitor (https://<fly-app>.fly.dev/colyseus) basic-auth
MONITOR_USER=teacher
MONITOR_PASS=change-me-please-${RANDOM}

# Sign tokens for player IDs (replace with `openssl rand -hex 32`)
JWT_SECRET=change-me-to-32-bytes-of-randomness

# NODE_ENV is set by fly.toml — leave alone
