{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter shared build && pnpm --filter client build",
  "outputDirectory": "apps/client/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "github": { "silent": true },
  "headers": [
    {
      "comment": "Vite-hashed bundles change filename per build → safe to cache forever.",
      "source": "/assets/(.*)\\.(js|css|woff2|woff|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "comment": "Game media (PNG/audio/JSON) keep STABLE filenames, so they must NOT be immutable — otherwise updated art stays pinned in browsers for a year. Revalidate via ETag (304 when unchanged) so updates appear immediately.",
      "source": "/assets/(.*)\\.(png|jpg|jpeg|gif|webp|svg|mp3|ogg|wav|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
